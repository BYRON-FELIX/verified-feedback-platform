[Unit]
Description=Reviewz Django application
After=network.target postgresql.service

[Service]
Type=simple
User=reviewz-site
Group=reviewz-site
WorkingDirectory=/var/www/reviewz
EnvironmentFile=/var/www/reviewz/.env.production
ExecStart=/var/www/reviewz/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:18081 --workers 3 --timeout 60
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/reviewz/media /var/www/reviewz/staticfiles

[Install]
WantedBy=multi-user.target
