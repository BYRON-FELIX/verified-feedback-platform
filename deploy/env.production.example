DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=GENERATE_ON_FIRST_SETUP
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=reviewz.site,www.reviewz.site
CSRF_TRUSTED_ORIGINS=https://reviewz.site,https://www.reviewz.site
CORS_ALLOWED_ORIGINS=https://reviewz.site,https://www.reviewz.site

# setup-vps.sh replaces this placeholder with a generated hex password.
DATABASE_URL=postgresql://reviewz_site_app:GENERATE_ON_FIRST_SETUP@127.0.0.1:5432/reviewz_site

PAYHERO_CALLBACK_BASE_URL=https://reviewz.site
# ---- PayHero ----
PAYHERO_BASE_URL=https://backend.payhero.co.ke
PAYHERO_AUTH_TOKEN=
PAYHERO_API_KEY=
PAYHERO_API_SECRET=
PAYHERO_CHANNEL_ID=0
