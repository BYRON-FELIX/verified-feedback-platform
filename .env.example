# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=Africa/Nairobi

# ---- Database ----
POSTGRES_DB=vfplatform
POSTGRES_USER=vf_user
POSTGRES_PASSWORD=vf_pass_dev_only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Email (dev: console) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com



# ---- CORS (prod only; leave blank in dev) ----
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ---- Platform defaults ----
PLATFORM_FEE_PERCENTAGE=25.00
WITHHOLDING_TAX_PERCENTAGE=5.00
SUBMISSION_AUTO_VERIFY=True

# ---- PayHero ----
PAYHERO_BASE_URL=https://backend.payhero.co.ke
PAYHERO_AUTH_TOKEN=
PAYHERO_API_KEY=
PAYHERO_API_SECRET=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_BASE_URL=https://yourdomain.com
PAYHERO_TIMEOUT_SECONDS=15